#!/bin/bash

# Find the chromium executable
CHROME=""
if command -v chromium-browser &> /dev/null; then
    CHROME="chromium-browser"
elif command -v chromium &> /dev/null; then
    CHROME="chromium"
elif command -v google-chrome-stable &> /dev/null; then
    CHROME="google-chrome-stable"
elif command -v google-chrome &> /dev/null; then
    CHROME="google-chrome"
else
    echo "Chromium or Google Chrome not found. Please install it."
    exit 1
fi

# Isolated profile and class for standalone experience
USER_DATA_DIR="$HOME/.config/figma-app"
mkdir -p "$USER_DATA_DIR"

$CHROME --app=https://www.figma.com/ \
        --user-data-dir="$USER_DATA_DIR" \
        --class="figma-app" \
        --name="figma-app" \
        --enable-features=TouchpadPinch,TouchpadPinchToZoom \
        --enable-pinch \
        --ozone-platform-hint=auto \
        --new-window \
        "$@"
