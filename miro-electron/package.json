{
  "name": "miro-app",
  "version": "1.0.0",
  "description": "Miro Desktop App (Pro)",
  "author": "Miro Custom",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.miro.desktop.pro",
    "productName": "MiroPro",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/electron.icns",
      "target": ["dmg", "zip"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "MiroPro needs access to your camera for video calls.",
        "NSMicrophoneUsageDescription": "MiroPro needs access to your microphone for video calls."
      }
    }
  }
}
